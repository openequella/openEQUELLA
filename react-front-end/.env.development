# Loaded by `vite build --mode development` (the `dev` script).
#
# `vite build` hard-codes NODE_ENV to "production" unless it is set explicitly,
# and a .env file is how Vite supports overriding it for development builds.
# Without this, the production branch in tsrc/mainui/index.tsx replaces
# console.log/debug/time with no-ops, silently swallowing all logging.
NODE_ENV=development
