{
  "name": "openequella-react-front-end",
  "private": true,
  "source": [
    "entrypoint/*.html",
    "entrypoint/scripts/*.js"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "targets": {
    "mainapp": {
      "distDir": "target/resources/web/reactjs",
      "engines": {
        "browserslist": "> 0.5%, last 2 versions, not dead"
      }
    },
    "mainappdev": {
      "distDir": "../Source/Plugins/Core/com.equella.core/target/scala-2.13/classes/web/reactjs",
      "engines": {
        "browserslist": "> 0.5%, last 2 versions, not dead"
      }
    }
  },
  "scripts": {
    "build:bundle": "NODE_OPTIONS=--max_old_space_size=4096 parcel build --no-scope-hoist --public-url=. --target mainapp",
    "build:langbundle": "tsx build-tools/BuildLanguageBundle.ts target/resources/lang/jsbundle.json",
    "build-storybook": "storybook build",
    "build": "npm-run-all build:*",
    "clean": "rm -rf target/ node_modules/ .parcel-cache/",
    "dev": "npm run build && parcel watch --public-url=. --target mainappdev",
    "explain:patches": "echo 'This project uses patch-package to apply critical modifications to dependencies. See the patches/README.md file for a detailed explanation.'",
    "install": "mkdir -p ../Source/Plugins/Core/com.equella.core/target/scala-2.13/classes/lang",
    "postinstall": "patch-package",
    "storybook": "storybook dev  -p 6006",
    "test": "jest test --maxWorkers 50%"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "4.1.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "9.2.0",
    "@mui/lab": "9.0.0-beta.6",
    "@mui/material": "9.2.0",
    "@mui/x-date-pickers": "9.10.0",
    "@mui/x-tree-view": "9.10.0",
    "@openequella/rest-api-client": "file:../oeq-ts-rest-api",
    "@tinymce/tinymce-react": "6.3.0",
    "axios": "1.18.1",
    "clsx": "2.1.1",
    "es6-object-assign": "1.1.0",
    "fp-ts": "2.16.11",
    "fp-ts-contrib": "0.1.29",
    "history": "4.10.1",
    "html-react-parser": "6.1.5",
    "io-ts": "2.2.22",
    "io-ts-types": "0.5.19",
    "jspolyfill-array.prototype.find": "0.1.3",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "object-hash": "3.0.0",
    "react": "19.2.8",
    "react-color": "2.19.3",
    "react-dom": "19.2.8",
    "react-dropzone": "17.0.0",
    "react-ga4": "3.0.1",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "react-router-hash-link": "2.4.3",
    "shallow-equal-object": "1.1.1",
    "sprintf-js": "1.1.3",
    "tinymce": "8.8.1",
    "wicked-good-xpath": "1.3.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@html-validate/jest-config": "3.18.2",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/cli": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/css-mediaquery": "0.1.4",
    "@types/jest": "30.0.0",
    "@types/jquery": "4.0.1",
    "@types/lodash": "4.17.25",
