<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
  "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
  <suppress files="[/\\]target[/\\]" checks=".*"/>
  <suppress files="Equella\/(.*\/)*build\/" checks=".*"/>
  <!-- ResourcesService is bound as a Guice eager singleton and cannot have a private constructor -->
  <suppress files="ResourcesService\.java" checks="HideUtilityClassConstructor"/>
</suppressions>
