{
  "extends": [
    "config:recommended",
    ":separateMultipleMajorReleases",
    ":dependencyDashboard",
    ":maintainLockFilesMonthly",
    "group:definitelyTyped"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "ignorePaths": [".github/**", "docker/docker-build/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^package\\.json$/"
      ],
      "matchStrings": [
        "coursier bootstrap com\\.puppycrawl\\.tools:checkstyle:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "com.puppycrawl.tools:checkstyle",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^package\\.json$/"
      ],
      "matchStrings": [
        "coursier bootstrap com\\.google\\.googlejavaformat:google-java-format:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "com.google.googlejavaformat:google-java-format",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^package\\.json$/"
      ],
      "matchStrings": [
        "coursier bootstrap org\\.scalameta::scalafmt-cli:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "org.scalameta:scalafmt-cli_3",
      "datasourceTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "groupName": "Coursier-bootstrapped dev tools",
      "matchDepNames": [
        "com.puppycrawl.tools:checkstyle",
        "com.google.googlejavaformat:google-java-format",
        "org.scalameta:scalafmt-cli_3"
      ]
    },
    {
      "description": "Wait 7 days before proposing any update to ensure stability",
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "Group all patch updates for devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "dev patch updates"
    },
    {
      "groupName": "Apache Axiom packages",
      "matchPackageNames": [
        "/^org.apache.ws.commons.axiom/"
      ]
    },
    {
      "groupName": "Apache Axis 2 packages",
      "matchPackageNames": [
        "/^org.apache.axis2/"
      ]
    },
    {
      "groupName": "Apache Curator packages",
      "matchPackageNames": [
        "/^org.apache.curator/"
      ]
    },
    {
      "groupName": "Apache CXF packages",
      "matchPackageNames": [
        "/^org.apache.cxf/"
      ]
    },
    {
      "groupName": "Apache HTTP Components packages",
      "matchPackageNames": [
        "/^org.apache.httpcomponents/"
      ]
    },
    {
      "groupName": "Apache Lucene packages",
      "matchPackageNames": [
        "/^org.apache.lucene/"
      ]
    },
    {
      "groupName": "Apache Rampart packages",
      "matchPackageNames": [
        "/^org.apache.rampart/"
      ]
    },
    {
      "groupName": "Apache Tika packages",
      "matchPackageNames": [
        "/^org.apache.tika/"
      ]
    },
    {
      "groupName": "Apache Tomcat packages",
      "matchPackageNames": [
        "/^org.apache.tomcat/"
      ]
    },
    {
      "groupName": "ESLint",
      "extends": ["packages:eslint"]
    },
    {
      "groupName": "Google Inject/Guice packages",
      "matchPackageNames": [
        "/^com.google.inject/"
      ]
    },
    {
      "groupName": "Google API Packages",
      "matchPackageNames": [
        "/^com.google.apis/"
      ]
    },
    {
      "groupName": "http4s packages",
      "matchPackageNames": [
        "/^org.http4s:http4s/"
      ]
    },
    {
      "groupName": "Jackson (XML) packages",
      "matchPackageNames": [
        "/^com.fasterxml.jackson/"
      ]
    },
    {
      "groupName": "Jacoco packages",
      "matchPackageNames": [
        "org.jacoco:*"
      ]
    },
    {
      "groupName": "Pragmatic DnD",
      "matchPackageNames": [
        "@atlaskit/pragmatic-drag-and-drop*"
      ]
    },
    {
      "groupName": "Scala",
      "matchPackageNames": [
        "scala",
        "sbt/sbt",
        "com.eed3si9n:sbt-assembly",
        "/^org.scala-lang.modules/",
        "/^org.scala-sbt/"
      ]
    },
    {
      "groupName": "SLF4J packages",
      "matchPackageNames": [
        "/^org.slf4j/"
      ]
    },
    {
      "groupName": "Swagger packages",
      "matchPackageNames": [
        "/^io.swagger/",
        "swagger-ui"
      ]
    },
    {
      "groupName": "Scala HTTP packages",
      "matchPackageNames": [
        "/^com.softwaremill.sttp/"
      ]
    },
    {
      "groupName": "TinyMCE",
      "matchPackageNames": [
        "@tinymce/tinymce-react",
        "tinymce"
      ]
    },
    {
      "groupName": "Typelevel Cats",
      "matchPackageNames": [
        "/^org.typelevel:cats/"
      ]
    },
    {
      "groupName": "XStream packages",
      "matchPackageNames": [
        "/^com.thoughtworks.xstream/"
      ]
    },
    {
      "matchPackageNames": [
        "@types/tough-cookie"
      ],
      "rangeStrategy": "replace"
    }
  ]
}
