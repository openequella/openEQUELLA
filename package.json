{
  "name": "openequella",
  "private": true,
  "scripts": {
    "coursier:checkstyle": "./coursier bootstrap com.puppycrawl.tools:checkstyle:13.8.0 -f -o node_modules/.bin/checkstyle -M com.puppycrawl.tools.checkstyle.Main",
    "coursier:google-java-format": "./coursier bootstrap com.google.googlejavaformat:google-java-format:1.35.0 -f -o node_modules/.bin/google-java-format --jvm-option-file google-java-format.jvmopts",
    "coursier:scalafmt": "./coursier bootstrap org.scalameta::scalafmt-cli:3.11.4 -f -o node_modules/.bin/scalafmt",
    "postinstall": "run-s coursier:*",
    "_eslint:ts": "eslint \"{react-front-end,Source/Plugins/Core/com.equella.core/test/javascript}/**/*.{js,ts,tsx}\"",
    "_prettier:scss": "prettier \"Source/Plugins/Core/com.equella.core/{js,resources}/**/*.{css,scss}\"",
    "format:scala": "find . -name \"*.scala\" -o -name \"*.sbt\" | xargs scalafmt",
    "format:java": "find . -name \"*.java\" | xargs google-java-format -r",
    "format:scss": "npm run _prettier:scss -- --write",
    "format:ts": "npm run _eslint:ts -- --fix",
    "check:scala": "find . -name '*.scala' -o -name '*.sbt' | xargs scalafmt --test",
    "check:java": "find . -name '*.java' | xargs google-java-format -n --set-exit-if-changed && ./checkstyle.sh",
    "check:license": "cd react-front-end && licensee --production --errors-only && cd -",
    "check:md": "remark -q --ignore-pattern NOTICE.md .",
    "check:scss": "npm run _prettier:scss -- --check",
    "check:ts": "npm run _eslint:ts --",
    "check:ts-types-source": "tsc --noEmit --project react-front-end/tsconfig.json",
    "check:ts-types-autotest": "tsc --noEmit --project \"autotest/IntegTester/front-end/tsconfig.json\"",
    "check": "run-s check:*",
    "format": "run-s format:*",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/eslint-parser": "8.0.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-notice": "1.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "licensee": "12.0.1",
    "lint-staged": "17.2.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6",
    "remark-cli": "12.0.1",
    "remark-lint-no-dead-urls": "2.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "6.0.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix",
    "*.{css,scss}": "prettier --write",
    "*.java": "google-java-format --replace",
    "*.{scala,sbt}": "scalafmt"
  },
  "remarkConfig": {
    "plugins": [
      "remark-validate-links",
      [
        "remark-lint-no-dead-urls",
        {
          "skipLocalhost": true,
          "skipUrlPatterns": [
            "http://oeq.localhost"
          ]
        }
      ]
    ]
  }
}
