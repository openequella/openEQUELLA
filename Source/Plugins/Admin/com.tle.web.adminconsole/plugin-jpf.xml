<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plugin PUBLIC "-//JPF//Java Plug-in Manifest 1.0"
  "http://jpf.sourceforge.net/plugin_1_0.dtd">
<plugin id="com.tle.web.adminconsole" version="1">
  <attributes>
    <attribute id="unpack" value="true" />
  </attributes>
  <requires>
    <import plugin-id="com.tle.common.i18n"/>
    <import plugin-id="com.tle.core.guice"/>
    <import plugin-id="com.tle.core.application"/>
    <import plugin-id="com.tle.web.core"/>
    <import plugin-id="com.tle.web.sections"/>
    <import plugin-id="com.tle.web.services"/>
    <import plugin-id="com.equella.admin"/>
    <import plugin-id="com.equella.base" exported="true"/>
    <import plugin-id="com.equella.core"/>
  </requires>
  <runtime>
    <library type="code" path="classes/" id="core">
      <export prefix="*"/>
    </library>
    <library type="resources" path="resources/" id="resources"/>
  </runtime>
  <!-- All extensions have been migrated to com.equella.core plugin -->
</plugin>
