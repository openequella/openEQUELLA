      <saveScript>/* save script to modify the item display title to be of the form:
&lt;title&gt;[, v.&lt;vol&gt;][, &lt;issuevalue&gt;][, &lt;year&gt;] 
where issuevalue is one of:
no. &lt;issuevalue&gt; (if a number)
dd mmmmmmm (if a date), or
&lt;issuevalue&gt; 							*/

var hTitle = xml.get(&apos;/item/copyright/title&apos;);
var hVol = xml.get(&apos;/item/copyright/volume&apos;);
var hIssType = xml.get(&apos;/item/copyright/issue/type&apos;);
var hIssVal = xml.get(&apos;/item/copyright/issue/value&apos;);
var hYear = xml.get(&apos;/item/copyright/publication/year&apos;);

/* testing - uncomment to show variables in XML
xml.set(&apos;/item/aaa/hTitle&apos;,hTitle);
xml.set(&apos;/item/aaa/hVol&apos;,hVol);
xml.set(&apos;/item/aaa/hIssType&apos;,hIssType);
xml.set(&apos;/item/aaa/hIssVal&apos;,hIssVal);
xml.set(&apos;/item/aaa/hYear&apos;,hYear);
 */

/* Add volume if it exists */
if (hVol != &apos;&apos;) {hTitle=hTitle+&apos;, vol. &apos;+hVol}

/* change IssVal from &lt;date&gt;T&lt;time&gt; to dd mmmmmmm */
var hIssValStr = hIssVal.toString();

/* testing - uncomment to show variables in XML
xml.set(&apos;/item/aaa/hIssValStr&apos;,hIssValStr);
xml.set(&apos;/item/aaa/hIssValLength&apos;,hIssValStr.length());
*/
if (hIssType = &apos;date&apos; &amp;&amp; hIssValStr.length()==19)
{
  hIssValDay=hIssValStr.substr(8,2);
  hIssValMonth=hIssValStr.substr(5,2);
  if (hIssValMonth==&quot;01&quot;) {hIssValMonth=&quot;January&quot;};
  if (hIssValMonth==&quot;02&quot;) {hIssValMonth=&quot;February&quot;};
  if (hIssValMonth==&quot;03&quot;) {hIssValMonth=&quot;March&quot;};
  if (hIssValMonth==&quot;04&quot;) {hIssValMonth=&quot;April&quot;};
  if (hIssValMonth==&quot;05&quot;) {hIssValMonth=&quot;May&quot;};
  if (hIssValMonth==&quot;06&quot;) {hIssValMonth=&quot;June&quot;};
  if (hIssValMonth==&quot;07&quot;) {hIssValMonth=&quot;July&quot;};
  if (hIssValMonth==&quot;08&quot;) {hIssValMonth=&quot;August&quot;};
  if (hIssValMonth==&quot;09&quot;) {hIssValMonth=&quot;September&quot;};
  if (hIssValMonth==&quot;10&quot;) {hIssValMonth=&quot;October&quot;};
  if (hIssValMonth==&quot;11&quot;) {hIssValMonth=&quot;November&quot;};
  if (hIssValMonth==&quot;12&quot;) {hIssValMonth=&quot;December&quot;};

  /* testing - uncomment to show variables in XML
  xml.set(&apos;/item/aaa/hIssValDay&apos;,hIssValDay);
  xml.set(&apos;/item/aaa/hIssValMonth&apos;,hIssValMonth);
  */
  hTitle=hTitle+&apos;, &apos;+hIssValDay+&apos; &apos;+hIssValMonth;
}
else
{
  /* if a value exists, check to see if it is actually a number before adding &quot;no.&quot; */
  if (hIssVal != &apos;&apos;)
  {
    if (isNaN(hIssVal))
    {
      hTitle=hTitle+&apos;, &apos;+hIssVal;
    }
    else
    {
      hTitle=hTitle+&apos;, no. &apos;+hIssVal;
    }
  }
}

/* Finally check for and add year to the display title */
if (hYear != &apos;&apos;) {hTitle=hTitle+&apos;, &apos;+hYear}

/* Store the created value back to the display title */
xml.set(&apos;/item/itembody/name&apos;,hTitle);

/* New Scripting */

var DEBUG = true;
// FUNCTIONS
function debuglog( message ) { 
	if ( DEBUG == &apos;True&apos; ) { logger.log(message); }
}
function setCollection(xpath) {
	xml.set(xpath, currentItem.getCollection().getName());
}
function setOrigination(sxpath, dxpath) {
	xml.deleteAll(dxpath);
	if ( xml.get(sxpath) == &apos;MERLOT&apos; ) { xml.set(dxpath, &apos;MERLOT&apos;); }
	else if ( xml.get(sxpath) == &apos;Books - Libraries Australia&apos; ) { xml.set(dxpath, &apos;Books - Libraries Australia&apos;); } 
	else if ( xml.get(sxpath) == &apos;Journals - Libraries Australia&apos; ) { xml.set(dxpath, &apos;Journals - Libraries Australia&apos;); } 
	else if ( xml.get(sxpath) == &apos;OER&apos; ) { xml.set(dxpath, &apos;OER Purchase&apos;); } 
	else { xml.set(dxpath, &apos;Contributed&apos;); }
}
function addOriginalContributor(destXpath)
{
	debuglog(&apos;begin addOriginalContributor with &apos; + destXpath);
	if (!xml.exists(destXpath))
	{
		var destNode = xml.createSubtree(destXpath);
		destNode.set(&apos;username&apos;, user.getUsername());
		destNode.set(&apos;firstName&apos;, user.getFirstName());
		destNode.set(&apos;lastName&apos;, user.getLastName());
		destNode.set(&apos;email&apos;, user.getEmail());
	}
	else
	{
		debuglog(&apos;destXpath already exits!&apos;);
	}
}
xml.set(&apos;item/lom/educational/learning.resource.type&apos;, &apos;Metadata&apos;);
addOriginalContributor(&apos;item/itembody/originalContributor&apos;);
setCollection(&apos;item/itembody/collection&apos;);
setOrigination(&apos;item/itembody/meta/switches/itemType&apos;, &apos;item/itembody/origination&apos;);</saveScript>
